{
  "name": "foreline/clean",
  "description": "PHP clean architecture framework",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Simakin Dima",
      "email": "dima@foreline.ru"
    }
  ],
  "require": {
    "php": ">=8.1",
    "psr/log": "^2.0 || ^3.0",
    "webmozart/assert": "^1.11",
    "symfony/http-foundation": ">6.3",
    "ext-curl": "*",
    "ramsey/uuid": "^4.8",
    "symfony/scheduler": "^7.3",
    "dragonmantank/cron-expression": "^3.4",
    "symfony/messenger": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "phpstan/phpstan": "*",
    "jetbrains/phpstorm-attributes": "*"
  },
  "autoload": {
    "psr-4": {
      "Domain\\": "src/Domain",
      "Infrastructure\\": "src/Infrastructure",
      "Presentation\\": "src/Presentation"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "scripts": {
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon"
  },
  "bin": [
    "bin/messenger-worker.php",
    "bin/event-monitor.php"
  ]
}
