# ASYNC EVENTS
# Enable async event dispatch for AsyncSubscriberInterface subscribers [Y|N]
ASYNC_EVENTS_ENABLED=N
# Messenger transport DSN [database://default | redis://127.0.0.1:6379/messages | in-memory://]
MESSENGER_TRANSPORT_DSN=database://default
